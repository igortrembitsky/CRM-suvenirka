#:kivy 2.3.0

ScreenManager:
    OrdersListScreen:

<OrdersListScreen>:
    name: "orders"

    BoxLayout:
        orientation: "vertical"
        padding: "10dp"
        spacing: "8dp"

        # --- Поиск ---
        BoxLayout:
            size_hint_y: None
            height: "44dp"
            spacing: "6dp"

            TextInput:
                id: search_input
                hint_text: "Поиск: ФИО / телефон / ID"
                multiline: False

            Spinner:
                id: status_spinner
                text: "all"
                values: ["all", "new", "processing", "packed", "shipped", "done", "canceled"]
                size_hint_x: None
                width: "120dp"

            Button:
                text: "Найти"
                size_hint_x: None
                width: "80dp"
                on_release: root.apply_filter()

        # --- Кнопки ---
        BoxLayout:
    size_hint_y: None
    height: "44dp"
    spacing: "6dp"

    Button:
        text: "+ Новый заказ"
        on_release: root.go_create()

    Button:
        text: "Обновить заказы"
        on_release: app.refresh_all()
        # --- Список заказов ---
        ScrollView:
            GridLayout:
                id: orders_list
                cols: 1
                spacing: "6dp"
                size_hint_y: None
                height: self.minimum_height
